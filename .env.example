# Copy this file to .env and fill the values before running:
#   pip install -r requirements.txt
#   forge build
#   python scripts/deploy_path_b.py

# Base Sepolia:
RPC_URL=https://sepolia.base.org
EXPECTED_CHAIN_ID=84532

# Base mainnet:
# RPC_URL=https://mainnet.base.org
# EXPECTED_CHAIN_ID=8453

# Deployer EOA private key. This wallet pays gas only.
# Do not commit .env. Use a fresh deployment wallet with limited funds.
DEPLOYER_PRIVATE_KEY=

# Safe and role addresses.
ADMIN_SAFE_ADDRESS=
GUARDIAN_SAFE_ADDRESS=
OPERATOR_ADDRESS=

# Testnet can use 600 for faster rehearsals.
# Mainnet should use 172800 (48 hours).
TIMELOCK_DELAY=600

# Optional resume values.
# If deployment fails after Timelock deployment, paste the printed Timelock address here
# and rerun; the script will skip Timelock deployment and continue.
# TIMELOCK_ADDRESS=0x...
# ESCROW_IMPL_ADDRESS=0x...

# Optional output file. Relative paths are resolved from the repo root.
DEPLOYMENT_OUTPUT=deployments/path_b_base_sepolia.json

# Optional transaction settings.
TX_TIMEOUT_SECONDS=300
# MAX_PRIORITY_FEE_PER_GAS_WEI=1000000
# MAX_FEE_PER_GAS_WEI=200000000

# Optional gas limits. Defaults are usually enough.
# TIMELOCK_DEPLOY_GAS=4000000
# TIMELOCK_RENOUNCE_GAS=200000
# ESCROW_IMPL_DEPLOY_GAS=8000000
# PROXY_DEPLOY_GAS=5000000

# Set true to validate config without sending transactions.
DRY_RUN=true
